# Copy to .env and fill in
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prohori
PORT=4000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Frontend values (may be set as Vercel environment variables)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
VITE_API_URL=http://localhost:4000

# Web push (FCM) — optional. Leave empty to disable push silently.
# From console.firebase.google.com → Project Settings → General (web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# From Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Backend push sender (Render env). Service-account JSON as a SINGLE LINE.
FIREBASE_SERVICE_ACCOUNT_JSON=
